  "selectors": {
    "excludeI18n": "[data-testid=\"permissions-selector-trigger\"], [data-testid=\"model-selector-trigger\"], [data-testid=\"model-selector-menu\"], [data-ag-i18n-ignore=\"1\"], #ag-claude-model-popover, #ag-claude-model-subpop"
