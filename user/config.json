    "customCss": true,
    "customJs": true,
    "claudeUxStepUnfold": true,
    "claudeUxCollapseAnimation": true,
    "claudeUxTodoCard": true,
    "claudeUxRunningTimer": true,
    "claudeUxContextRing": true,
    "claudeUxModelMenu": true,
    "claudeUxInlineUndo": true,
    "claudeUxFolderStatus": true,
    "claudeUxRecentSection": false,
    "claudeUxProjects": true,
    "claudeUxHideSidebarProjects": true,
    "claudeUxCustomizations": true,
    "claudeUxCodeFold": true
